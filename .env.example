# Copy to .env and fill in values from each dashboard. Do not commit .env.

# Signs staff and vendor session cookies. At least 32 characters. Required on Vercel.
SIGNING_SECRET=

# Opens /staff/vendors. At least 16 characters.
STAFF_ACCESS_TOKEN=

# Supabase secret key. Server only. Never expose this in the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend. Both addresses must be on the verified timelessconsortium.com domain.
RESEND_API_KEY=
RESEND_FROM_WELCOME=Timeless Consortium <welcome@timelessconsortium.com>
RESEND_FROM_OFFICE=Timeless Consortium <office@timelessconsortium.com>
# Optional fallback when Resend is not set.
# EMAIL_WEBHOOK_URL=

# Square. Leave SQUARE_ENVIRONMENT as sandbox until the live location is ready.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
