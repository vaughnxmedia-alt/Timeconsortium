---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EventSchema from "../components/EventSchema.astro";
import { site } from "../config/site";

interface Props {
  title: string;
  description: string;
  path: string;
  eventSchema?: boolean;
  robots?: string;
}

const { title, description, path, eventSchema = false, robots } = Astro.props;
const canonical = new URL(path, site.url).href;
const image = new URL(site.shareImage, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js-reveal");
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#151313" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={site.shareImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={site.shareImageAlt} />
    {eventSchema && <EventSchema />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const navToggle = document.querySelector("#nav-toggle");
      const nav = document.querySelector("#site-nav");
      const desktop = window.matchMedia("(min-width: 980px)");

      const eventsButton = nav?.querySelector(".nav-label");
      const eventsGroup = eventsButton?.closest(".nav-group");

      const collapseEvents = () => {
        eventsGroup?.classList.remove("is-open");
        if (eventsButton instanceof HTMLButtonElement) {
          eventsButton.setAttribute("aria-expanded", "false");
        }
      };

      const closeNav = () => {
        if (navToggle instanceof HTMLInputElement) navToggle.checked = false;
        collapseEvents();
      };

      eventsButton?.addEventListener("click", () => {
        if (desktop.matches || !(eventsButton instanceof HTMLButtonElement)) return;
        const open = !eventsGroup?.classList.contains("is-open");
        eventsGroup?.classList.toggle("is-open", open);
        eventsButton.setAttribute("aria-expanded", open ? "true" : "false");
      });

      nav?.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest("a")) closeNav();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeNav();
          if (!desktop.matches && navToggle instanceof HTMLInputElement) navToggle.focus();
        }
      });

      // iOS Safari only applies :active styles when a touch listener is present.
      document.addEventListener("touchstart", () => {}, { passive: true });

      desktop.addEventListener("change", () => {
        if (desktop.matches) closeNav();
      });
    </script>
    <script is:inline>
      if (document.documentElement.classList.contains("js-reveal")) {
        const selector = [
          ".site-header",
          "main .page-mast",
          "main .identity",
          "main .evening",
          "main .mast",
          "main .lede",
          "main .editorial > div",
          "main .editorial-media figure",
          "main .itinerary-note",
          "main .itinerary-item",
          "main .itinerary-figure",
          "main .itinerary-cta",
          "main .concepts li",
          "main .recap",
          "main .lead-decor",
          "main .home-follow",
          "main .about-intro",
          "main .featured",
          "main .story-hero",
          "main .story-head",
          "main .story-spread",
          "main .story-back",
          "main .vendor-hub-lede",
          "main .vendor-card",
          "main section",
          "main article",
          "footer.footer",
        ].join(",");
        const all = [...document.querySelectorAll(selector)].filter((element) => {
          const box = element.getBoundingClientRect();
          return box.width > 0 && box.height > 8;
        });
        const nodes = all.filter(
          (element) => !all.some((other) => other !== element && element.contains(other)),
        );
        for (const parent of all) {
          if (nodes.includes(parent)) continue;
          if (!nodes.some((node) => parent.contains(node))) continue;
          for (const child of parent.children) {
            if (!(child instanceof HTMLElement)) continue;
            const holdsNode = nodes.some((node) => child === node || child.contains(node));
            if (holdsNode) continue;
            if (!child.matches("h2, h3, p, .eyebrow")) continue;
            if (child.getBoundingClientRect().height < 8) continue;
            nodes.push(child);
          }
        }

        let intro = 0;
        const viewBottom = window.innerHeight * 0.92;
        for (const element of nodes) {
          element.classList.add("reveal");
          if (element.getBoundingClientRect().top < viewBottom) {
            element.style.transitionDelay = `${Math.min(intro, 7) * 120}ms`;
            intro += 1;
          }
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.16 },
        );

        requestAnimationFrame(() => {
          for (const element of nodes) observer.observe(element);
        });
      }
    </script>
  </body>
</html>
