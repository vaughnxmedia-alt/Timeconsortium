---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EventSchema from "../components/EventSchema.astro";
import { site } from "../config/site";

interface Props {
  title: string;
  description: string;
  path: string;
  eventSchema?: boolean;
  robots?: string;
}

const { title, description, path, eventSchema = false, robots } = Astro.props;
const canonical = new URL(path, site.url).href;
const image = new URL(site.shareImage, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#151313" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={site.shareImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={site.shareImageAlt} />
    {eventSchema && <EventSchema />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const navToggle = document.querySelector("#nav-toggle");
      const nav = document.querySelector("#site-nav");
      const desktop = window.matchMedia("(min-width: 980px)");

      const closeNav = () => {
        if (navToggle instanceof HTMLInputElement) navToggle.checked = false;
      };

      nav?.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest("a")) closeNav();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeNav();
          if (!desktop.matches && navToggle instanceof HTMLInputElement) navToggle.focus();
        }
      });

      // iOS Safari only applies :active styles when a touch listener is present.
      document.addEventListener("touchstart", () => {}, { passive: true });

      desktop.addEventListener("change", () => {
        if (desktop.matches) closeNav();
      });
    </script>
  </body>
</html>
