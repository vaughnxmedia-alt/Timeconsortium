---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import { pages, vendor } from "../../config/site";
import { specialtyGroups } from "../../lib/vendor/specialties";
import { readReceipt } from "../../lib/vendor/server";

Astro.response.headers.set("Cache-Control", "private, no-store");

const saved = await readReceipt(Astro.cookies);
const showError = Astro.url.searchParams.get("error") === "1";
---

<Base title={pages.vendorRequest.title} description={pages.vendorRequest.description} path={vendor.requestPath}>
  <header class="page-mast">
    <div class="page-mast-inner">
      <p class="eyebrow">{vendor.navLabel}</p>
      <h1>{vendor.formTitle}</h1>
      <p>{vendor.formIntro}</p>
    </div>
  </header>
  <div class="page-body">
    <div class="page-body-inner">
      <section id="vendor-interest">
        {
          saved && (
            <p class="confirmation" role="status">
              {vendor.confirmation}
            </p>
          )
        }
        {
          showError && (
            <p class="form-error" role="alert">
              The request was not saved. Check the fields and try again.
            </p>
          )
        }
        <form id="vendor-request" class="form" data-save-form method="post" action="/api/vendors">
          <p class="form-error" data-form-error hidden></p>
          <p class="confirmation" data-form-confirmation hidden>{vendor.confirmation}</p>
          <div class="hp" hidden aria-hidden="true">
            <label for="vendor-company">Company website</label>
            <input id="vendor-company" name="company_website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="field">
            <label for="vendor-first">First name</label>
            <input id="vendor-first" name="firstName" type="text" autocomplete="given-name" maxlength="60" required />
          </div>
          <div class="field">
            <label for="vendor-last">Last name</label>
            <input id="vendor-last" name="lastName" type="text" autocomplete="family-name" maxlength="60" required />
          </div>
          <div class="field">
            <label for="vendor-email">Email</label>
            <input id="vendor-email" name="email" type="email" autocomplete="email" maxlength="200" required />
          </div>
          <div class="field">
            <label for="vendor-phone">Phone</label>
            <input id="vendor-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" required />
          </div>
          <div class="field">
            <label for="vendor-business">Business name</label>
            <input
              id="vendor-business"
              name="businessName"
              type="text"
              autocomplete="organization"
              maxlength="160"
              required
            />
          </div>
          <div class="field">
            <label for="vendor-specialty-group">Specialty</label>
            <select id="vendor-specialty-group" name="specialtyGroup" required data-specialty-group>
              <option value="">Choose a specialty</option>
              {specialtyGroups.map((group) => (
                <option value={group.id}>{group.label}</option>
              ))}
            </select>
          </div>
          <div class="field" data-specialty-other hidden>
            <label for="vendor-specialty-other">Other specialty</label>
            <input id="vendor-specialty-other" name="specialtyOther" type="text" maxlength="160" />
          </div>
          <div class="field">
            <label for="vendor-portfolio">Website <span class="optional">Optional</span></label>
            <input
              id="vendor-portfolio"
              name="portfolio"
              type="url"
              inputmode="url"
              placeholder="https://"
              maxlength="400"
            />
          </div>
          <div class="field">
            <label for="vendor-contribution">What would you like to bring to Reverie &amp; Ember?</label>
            <textarea id="vendor-contribution" name="contribution" maxlength="800" required></textarea>
          </div>
          <button class="button" type="submit">Submit application</button>
        </form>
        <p class="sponsor-prompt">
          <a class="text-link" href="/vendor-hub">Back to {vendor.navLabel}</a>
        </p>
      </section>
    </div>
  </div>
</Base>

<script>
  const specialtyGroup = document.querySelector("[data-specialty-group]");
  const specialtyOther = document.querySelector("[data-specialty-other]");
  const specialtyOtherInput = document.querySelector("#vendor-specialty-other");
  const syncSpecialty = () => {
    const showOther =
      specialtyGroup instanceof HTMLSelectElement && specialtyGroup.value === "other";
    if (specialtyOther instanceof HTMLElement) specialtyOther.hidden = !showOther;
    if (specialtyOtherInput instanceof HTMLInputElement) {
      specialtyOtherInput.required = showOther;
      if (!showOther) specialtyOtherInput.value = "";
    }
  };
  specialtyGroup?.addEventListener("change", syncSpecialty);
  syncSpecialty();

  document.querySelectorAll("[data-save-form]").forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const error = form.querySelector("[data-form-error]");
      const confirmation = form.querySelector("[data-form-confirmation]");
      const button = form.querySelector("button[type='submit']");
      if (error instanceof HTMLElement) error.hidden = true;
      if (confirmation instanceof HTMLElement) confirmation.hidden = true;
      if (button instanceof HTMLButtonElement) button.disabled = true;
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { accept: "application/json" },
        });
        const data = await response.json().catch(() => ({}));
        const saved = response.ok && data.saved === true;
        if (!saved) {
          if (error instanceof HTMLElement) {
            error.textContent =
              typeof data.message === "string" && data.message
                ? data.message
                : "The request was not saved.";
            error.hidden = false;
          }
          return;
        }
        form.reset();
        if (confirmation instanceof HTMLElement) confirmation.hidden = false;
      } catch {
        if (error instanceof HTMLElement) {
          error.textContent = "The request was not saved.";
          error.hidden = false;
        }
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  });
</script>
