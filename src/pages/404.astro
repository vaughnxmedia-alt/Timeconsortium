---
import Base from "../layouts/Base.astro";
import { event } from "../config/site";
---

<Base
  title="Page not found | Timeless Consortium"
  description="This page is not part of the Timeless Consortium site."
  path="/404"
>
  <header class="page-mast">
    <div class="page-mast-inner">
      <p class="eyebrow">Timeless Consortium</p>
      <h1>Page not found</h1>
      <p>The page you requested is not available.</p>
      <p>
        <a class="text-link" href="/">Home</a>
      </p>
      <p>
        <a class="text-link" href={event.path}>{event.name}</a>
      </p>
    </div>
  </header>
</Base>
