---
import Base from "../layouts/Base.astro";
import Closing from "../components/Closing.astro";
import HotelStay from "../components/HotelStay.astro";
import LeadDecorPartner from "../components/LeadDecorPartner.astro";
import TicketCta from "../components/TicketCta.astro";
import { eveningPage, event, images, pages } from "../config/site";
---

<Base
  title={pages.home.title}
  description={pages.home.description}
  path="/"
  eventSchema
>
  <div class="spread">
    <article class="identity">
      <figure class="frame">
        <img
          src={images.header.src}
          alt={images.header.alt}
          width={images.header.width}
          height={images.header.height}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
      <div class="identity-copy">
        <h1>{event.name}</h1>
        <p class="tagline">{event.tagline}</p>
        <p class="kicker">{event.kicker}</p>
        <hr class="rule" />
        <p class="date-line">{event.dateLabel}</p>
        <p class="place">{event.placeLine}</p>
        <TicketCta note={false} />
        <p>
          <a class="text-link" href={event.path}>Details for invitations and press</a>
        </p>
      </div>
    </article>

    <div class="column">
      <section id="evening" class="evening">
        {
          images.runway.src && (
            <figure class="frame">
              <img
                src={images.runway.src}
                alt={images.runway.alt}
                width={images.runway.width}
                height={images.runway.height}
                loading="lazy"
                decoding="async"
              />
            </figure>
          )
        }
        <div class="evening-copy">
          <p class="eyebrow">{eveningPage.navLabel}</p>
          <h2>{eveningPage.homeTeaserTitle}</h2>
          <hr class="rule rule-ink" />
          <p>{eveningPage.homeTeaser}</p>
          <p>
            <a class="text-link" href={eveningPage.path}>{eveningPage.homeTeaserLink}</a>
          </p>
        </div>
      </section>
      <Closing />
    </div>
  </div>

  <LeadDecorPartner layout="home" />

  <div class="home-follow">
    <HotelStay layout="card" />
  </div>
</Base>
