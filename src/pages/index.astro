---
import Base from "../layouts/Base.astro";
import Closing from "../components/Closing.astro";
import HotelStay from "../components/HotelStay.astro";
import LeadDecorPartner from "../components/LeadDecorPartner.astro";
import TicketCta from "../components/TicketCta.astro";
import { eveningPage, event, images, pages, tickets } from "../config/site";

const launchAt = Date.parse(tickets.launchAt);
const placeRevealed = Number.isFinite(launchAt) && Date.now() >= launchAt;
const remaining = placeRevealed ? 0 : Math.max(0, launchAt - Date.now());
const clock = {
  days: Math.floor(remaining / 86_400_000),
  hours: Math.floor(remaining / 3_600_000) % 24,
  minutes: Math.floor(remaining / 60_000) % 60,
  seconds: Math.floor(remaining / 1000) % 60,
};
const pad = (value: number) => String(value).padStart(2, "0");
---

<Base
  title={pages.home.title}
  description={pages.home.description}
  path="/"
  eventSchema
>
  <div class="spread">
    <article class="identity">
      <figure class="frame">
        <img
          src={images.header.src}
          alt={images.header.alt}
          width={images.header.width}
          height={images.header.height}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
      <div class="identity-copy">
        <h1>{event.name}</h1>
        <p class="kicker">A wedding and event experience</p>
        <p class="date-line">{event.dateLabel}</p>
        {
          !placeRevealed && (
            <p class="launch-release">Tickets and the location will be released New Year’s 2027.</p>
          )
        }
        <p class="place" data-place-reveal hidden={!placeRevealed}>{event.placeLine}</p>
        <div class="launch-row">
          {
            !placeRevealed && (
              <div
                class="launch-clock"
                role="timer"
                data-launch={tickets.launchAt}
                aria-label={`${clock.days} days until tickets are available`}
              >
                <p>Until tickets are available</p>
                <ol>
                  <li><strong data-unit="days">{pad(clock.days)}</strong><span>Days</span></li>
                  <li><strong data-unit="hours">{pad(clock.hours)}</strong><span>Hours</span></li>
                  <li><strong data-unit="minutes">{pad(clock.minutes)}</strong><span>Minutes</span></li>
                  <li><strong data-unit="seconds">{pad(clock.seconds)}</strong><span>Seconds</span></li>
                </ol>
              </div>
            )
          }
          <TicketCta note={false} />
        </div>
      </div>
    </article>

    <div class="column">
      <section id="evening" class="evening">
        {
          images.runway.src && (
            <figure class="frame">
              <img
                src={images.runway.src}
                alt={images.runway.alt}
                width={images.runway.width}
                height={images.runway.height}
                loading="lazy"
                decoding="async"
              />
            </figure>
          )
        }
        <div class="evening-copy">
          <h2>{eveningPage.homeTeaserTitle}</h2>
          <hr class="rule" />
          <p>
            Candlelit tablescapes, wedding and event design, and a runway of bridal fashion and
            eveningwear.
          </p>
          <p>
            <a class="text-link" href={eveningPage.path}>Explore the Evening</a>
          </p>
        </div>
      </section>
      <Closing
        heading="Join the List"
        supporting="Receive the ticket announcement and a first look at the evening."
        submitLabel="Notify Me"
        showEyebrow={false}
      />
    </div>
  </div>

  <LeadDecorPartner layout="home" />

  <div class="home-follow">
    <HotelStay layout="card" />
  </div>
  <script>
    const clock = document.querySelector(".launch-clock");
    const place = document.querySelector("[data-place-reveal]");
    if (clock instanceof HTMLElement) {
      const launch = Date.parse(clock.dataset.launch || "");
      const units = ["days", "hours", "minutes", "seconds"] as const;
      const pad = (value: number) => String(value).padStart(2, "0");
      const tick = () => {
        const left = launch - Date.now();
        if (!Number.isFinite(launch) || left <= 0) {
          clock.hidden = true;
          if (place instanceof HTMLElement) place.hidden = false;
          return;
        }
        const parts = {
          days: Math.floor(left / 86_400_000),
          hours: Math.floor(left / 3_600_000) % 24,
          minutes: Math.floor(left / 60_000) % 60,
          seconds: Math.floor(left / 1000) % 60,
        };
        for (const unit of units) {
          const node = clock.querySelector(`[data-unit="${unit}"]`);
          if (node) node.textContent = pad(parts[unit]);
        }
        clock.setAttribute(
          "aria-label",
          `${parts.days} days, ${parts.hours} hours, ${parts.minutes} minutes until tickets and the location`,
        );
        window.setTimeout(tick, 1000);
      };
      tick();
    }
  </script>
</Base>
