---
export const prerender = false;

import Base from "../../../layouts/Base.astro";
import EventBar from "../../../components/EventBar.astro";
import HqSeries from "../../../components/HqSeries.astro";
import HqShell from "../../../components/HqShell.astro";
import { isStaff } from "../../../lib/backend/staff";
import { weekOf, weekStarts } from "../../../lib/backend/weeks.mjs";
import { emailConfigured, listQueue, STATUS_LABEL } from "../../../lib/vendor/server";

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const member = await isStaff(Astro.cookies);
if (!member) return Astro.redirect("/staff?next=/staff/vendors");
if (!member.passwordSet) return Astro.redirect("/staff/password");
const queue = await listQueue();
const weeks = weekStarts();
const applications = weeks.map(
  (week) => queue.vendors.filter((item) => weekOf(item.createdAt) === week).length,
);
const counts = {
  submitted: queue.vendors.filter((item) => item.status === "submitted").length,
  under_review: queue.vendors.filter((item) => item.status === "under_review").length,
  confirmed: queue.vendors.filter((item) => item.status === "confirmed").length,
  declined: queue.vendors.filter((item) => item.status === "declined").length,
};
---

<Base
  hq
  title="Vendor review | Timeless Consortium"
  description="Private review queue for vendor requests and sponsorship inquiries."
  path="/staff/vendors"
  robots="noindex, nofollow"
>
  <HqShell member={member} path="/staff/vendors">
    <EventBar current="vendors" />
    <h1 class="hq-title">Vendors</h1>
    {
      !emailConfigured() && (
        <p class="preview-note">
          Email delivery is not configured. Set RESEND_API_KEY, RESEND_FROM_WELCOME, and RESEND_FROM_OFFICE before receipts or access links are emailed.
        </p>
      )
    }
    <HqSeries
      title="Applications"
      weeks={weeks}
      values={applications}
      series="Applications"
      empty="No vendor applications have been recorded yet."
    />
    <ul class="event-facts">
      <li>{counts.submitted} submitted</li>
      <li>{counts.under_review} under review</li>
      <li>{counts.confirmed} confirmed</li>
      <li>{counts.declined} declined</li>
    </ul>
      <section>
        <h2>Requests</h2>
        {
          queue.vendors.length === 0 ? (
            <p>No vendor requests have been saved.</p>
          ) : (
            <ul class="review-list">
              {queue.vendors.map((item) => (
                <li class="review-card">
                  <h3>{item.businessName}</h3>
                  <p>
                    {item.firstName || item.contactName} {item.lastName} · {item.email}
                  </p>
                  <p>{item.phone || "No phone"}{item.portfolio ? ` · ${item.portfolio}` : ""}</p>
                  <p>{STATUS_LABEL[item.status]}</p>
                  {item.staffNotes && <p>{item.staffNotes}</p>}
                  <p>
                    <a href={`/staff/vendors/${item.id}`}>Open request</a>
                  </p>
                </li>
              ))}
            </ul>
          )
        }
      </section>
  </HqShell>
</Base>
