---
export const prerender = false;

import Base from "../../../layouts/Base.astro";
import HqShell from "../../../components/HqShell.astro";
import { isStaff, listStaff } from "../../../lib/backend/staff";
import { takeError, takeLink } from "../../../lib/vendor/server";

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const member = await isStaff(Astro.cookies);
if (!member) return Astro.redirect("/staff?next=/staff/team");
if (!member.passwordSet) return Astro.redirect("/staff/password");

const people = member.role === "owner" ? await listStaff() : [];
const link = takeLink(Astro.cookies);
const error = takeError(Astro.cookies);
const statusLabel = {
  invited: "Invited",
  active: "Active",
  revoked: "Access removed",
};
---

<Base
  hq
  title="Team | Timeless Consortium"
  description="Private team invitations."
  path="/staff/team"
  robots="noindex, nofollow"
>
  <HqShell member={member} path="/staff/team">
    <h1 class="hq-title">Team</h1>
      {
        member.role !== "owner" ? (
          <p>Only the owner can invite or remove the team.</p>
        ) : (
          <>
            {error && <p class="form-error" role="alert">{error}</p>}
            {
              link === "sent" && (
                <p>The invitation was sent from the office email. It includes the password you set and a button to sign in.</p>
              )
            }
            <form class="form" method="post" action="/api/staff-team">
              <div class="field">
                <label for="team-first">First name</label>
                <input id="team-first" name="firstName" type="text" maxlength="60" required />
              </div>
              <div class="field">
                <label for="team-last">Last name</label>
                <input id="team-last" name="lastName" type="text" maxlength="60" required />
              </div>
              <div class="field">
                <label for="team-email">Email</label>
                <input id="team-email" name="email" type="email" maxlength="200" required />
              </div>
              <div class="field">
                <label for="team-phone">Phone</label>
                <input id="team-phone" name="phone" type="tel" maxlength="30" required />
              </div>
              <div class="field">
                <label for="team-password">Password</label>
                <input id="team-password" name="password" type="password" minlength="10" autocomplete="new-password" required />
                <p>This password is emailed to them from the office address, with a button to sign in.</p>
              </div>
              <button class="button" type="submit">Create invitation</button>
            </form>
            <ul class="review-list">
              {people.map((person) => (
                <li class="review-card">
                  <h3>{[person.firstName, person.lastName].filter(Boolean).join(" ") || person.email}</h3>
                  <p>
                    {person.email}{person.phone ? ` · ${person.phone}` : ""}
                  </p>
                  <p>{person.role === "owner" ? "Owner" : "Team"} · {statusLabel[person.status]}</p>
                  {
                    person.id !== member.id && (
                      <form method="post" action="/api/staff-team">
                        <input type="hidden" name="intent" value="delete" />
                        <input type="hidden" name="id" value={person.id} />
                        <button class="text-link" type="submit">Delete</button>
                      </form>
                    )
                  }
                </li>
              ))}
            </ul>
          </>
        )
      }
  </HqShell>
</Base>
