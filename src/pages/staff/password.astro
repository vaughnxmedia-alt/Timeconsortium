---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import { isStaff } from "../../lib/backend/staff";

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const member = await isStaff(Astro.cookies);
if (!member) return Astro.redirect("/staff");
if (member.passwordSet) return Astro.redirect("/staff");
const error = Astro.url.searchParams.get("error") ?? "";
---

<Base
  title="Choose a password | Timeless Consortium"
  description="Choose the password for the Timeless Consortium team account."
  path="/staff/password"
  robots="noindex, nofollow"
>
  <header class="page-mast">
    <div class="page-mast-inner">
      <p class="eyebrow">Teams</p>
      <h1>Choose a password</h1>
    </div>
  </header>
  <div class="page-body">
    <div class="page-body-inner">
      <p>Set the password for {member.email}. This owner account keeps every team permission.</p>
      <form class="form" method="post" action="/api/staff-password">
        {error && <p class="form-error" role="alert">{error}</p>}
        <div class="field">
          <label for="staff-password">Password</label>
          <input id="staff-password" name="password" type="password" autocomplete="new-password" minlength="10" required />
        </div>
        <div class="field">
          <label for="staff-password-confirm">Confirm password</label>
          <input id="staff-password-confirm" name="confirm" type="password" autocomplete="new-password" minlength="10" required />
        </div>
        <button class="button" type="submit">Save password</button>
      </form>
    </div>
  </div>
</Base>
