---
import Base from "../layouts/Base.astro";
import FeatureSpread from "../components/FeatureSpread.astro";
import { aboutPage, featuredExperience, namibiaEditorial } from "../config/site";
---

<Base title={aboutPage.title} description={aboutPage.description} path={aboutPage.path}>
  <div class="about-page">
    <section class="about-intro">
      <figure class="frame">
        <img
          src={aboutPage.opening.src}
          alt={aboutPage.opening.alt}
          width={aboutPage.opening.width}
          height={aboutPage.opening.height}
          style={`object-position: ${aboutPage.opening.position}`}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
      <div class="about-copy">
        <h1>{aboutPage.headline}</h1>
        {aboutPage.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <FeatureSpread id="featured-title" {...featuredExperience} />

    <FeatureSpread
      id="editorial-title"
      {...namibiaEditorial.feature}
      href={namibiaEditorial.path}
      image={namibiaEditorial.hero}
    />
  </div>
</Base>
