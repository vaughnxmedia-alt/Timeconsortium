---
import { ticketSignup } from "../config/site";
---

<form class="ticket-signup form" data-ticket-signup method="post" action="/api/ticket-signup" novalidate>
  <p class="form-error" data-form-error hidden></p>
  <p class="confirmation ticket-signup-success" data-form-confirmation hidden role="status">
    {ticketSignup.success}
  </p>
  <div class="ticket-signup-fields" data-ticket-fields>
    <div class="field">
      <label for="ticket-email">{ticketSignup.emailLabel}</label>
      <input
        id="ticket-email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength="200"
        required
      />
    </div>
    <button class="button" type="submit" data-ticket-submit>{ticketSignup.submitLabel}</button>
  </div>
</form>

<script>
  document.querySelectorAll("[data-ticket-signup]").forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const error = form.querySelector("[data-form-error]");
      const confirmation = form.querySelector("[data-form-confirmation]");
      const fields = form.querySelector("[data-ticket-fields]");
      const button = form.querySelector("[data-ticket-submit]");
      if (error instanceof HTMLElement) {
        error.hidden = true;
        error.textContent = "";
      }
      if (confirmation instanceof HTMLElement) confirmation.hidden = true;
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = "Joining…";
      }
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { accept: "application/json" },
        });
        const data = await response.json().catch(() => ({}));
        const saved = response.ok && data.saved === true;
        if (!saved) {
          if (error instanceof HTMLElement) {
            error.textContent =
              typeof data.message === "string" && data.message
                ? data.message
                : "We could not complete your signup. Please try again.";
            error.hidden = false;
          }
          return;
        }
        form.reset();
        if (fields instanceof HTMLElement) fields.hidden = true;
        if (confirmation instanceof HTMLElement) confirmation.hidden = false;
      } catch {
        if (error instanceof HTMLElement) {
          error.textContent = "We could not complete your signup. Please try again.";
          error.hidden = false;
        }
      } finally {
        if (button instanceof HTMLButtonElement) {
          button.disabled = false;
          button.textContent = "Join the List";
        }
      }
    });
  });
</script>
