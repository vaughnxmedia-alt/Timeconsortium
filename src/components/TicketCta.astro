---
import { isPreview, ticketView } from "../lib/presentation";

interface Props {
  note?: boolean;
}

const { note = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const ticket = ticketView(path);
---

{
  ticket.mode === "link" || ticket.mode === "signup" ? (
    <a class="button" href={ticket.href}>
      {ticket.label}
    </a>
  ) : isPreview ? (
    <div class="ticket-pending">
      <button class="button" type="button" aria-disabled="true">
        {ticket.label}
      </button>
      {note && <p class="preview-note">{ticket.previewNote}</p>}
    </div>
  ) : (
    <p class="ticket-message">{ticket.message}</p>
  )
}
