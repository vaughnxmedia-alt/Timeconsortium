---
import { aboutPage, eveningPage, site, vendor } from "../config/site";
import { ticketView } from "../lib/presentation";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const stayHref =
  path === "/" || path === "/reverie-and-ember" ? "#stay" : "/#stay";
const ticket = ticketView(path);
const vendorCurrent =
  path === "/vendor-hub" || path.startsWith("/vendor-hub/") ? "page" : undefined;
const aboutCurrent = path === "/about" ? "page" : undefined;
const eveningCurrent = path === eveningPage.path ? "page" : undefined;
---

<header class="site-header">
  <div class="header-bar">
    <a class="brand" href="/" aria-label={site.logo.alt}>
      <img
        src={site.logo.src}
        alt=""
        width={site.logo.width}
        height={site.logo.height}
      />
    </a>
    <input id="nav-toggle" class="nav-check" type="checkbox" aria-controls="site-nav" />
    <label class="nav-toggle" for="nav-toggle">
      <span class="menu-open-label">Menu</span>
      <span class="menu-close-label">Close</span>
    </label>
    <nav id="site-nav" class="nav" data-nav aria-label="Primary">
      <ul>
        <li><a href={aboutPage.path} aria-current={aboutCurrent}>{aboutPage.label}</a></li>
        <li><a href={eveningPage.path} aria-current={eveningCurrent}>{eveningPage.navLabel}</a></li>
        <li><a href="/vendor-hub" aria-current={vendorCurrent}>{vendor.navLabel}</a></li>
        <li><a href={stayHref}>Plan Your Stay</a></li>
        <li>
          <a
            class="button button-small"
            href={ticket.mode === "link" || ticket.mode === "signup" ? ticket.href : "/#tickets"}
          >
            {ticket.label}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
